# Environment: development, staging, production
ENVIRONMENT=development

# Binance API Credentials (https://www.binance.com/en/account/api-management)
BINANCE_API_KEY=your_api_key_here
BINANCE_API_SECRET=your_api_secret_here
BINANCE_TESTNET=true

# Database Configuration
DB_HOST=timescaledb
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=marketmaker_dev
DB_NAME=marketmaker

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# NATS Configuration
NATS_URL=nats://nats:4222
NATS_JETSTREAM_ENABLED=true

# Prometheus Configuration
PROMETHEUS_PORT=8001
PROMETHEUS_ADDR=0.0.0.0

# Grafana Configuration
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin
GRAFANA_PORT=3000

# Strategy Parameters
SYMBOL=BTCUSDT
MIN_NOTIONAL_USDT=50.0
MAX_LEVERAGE=5.0

# Avellaneda-Stoikov Parameters
GAMMA=0.10
TIME_HORIZON=5.0
ALPHA_SKEW=0.40

# Risk Management
MAX_INVENTORY_BTC=0.02
STOP_LOSS_PCT=-0.01
MAX_POSITION_NOTIONAL=1000.0

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json  # json or console

# Development Settings
DEBUG=false
DRY_RUN=true
SIMULATE=false

# Monitoring
METRICS_ENABLED=true
TRACE_ENABLED=false
